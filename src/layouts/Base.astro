---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import Pedido from '../components/Pedido.astro';
import { siteConfig } from '../../site.config';
import Seo from '../components/Seo.astro';
// Preload de la fuente principal (evita el reflow del wordmark → CLS ≈ 0)
import dmSansWoff2 from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  path?: string;
  ogImage?: string;
  noindex?: boolean;
  showWhatsApp?: boolean;
}
const { title, description, path, ogImage, noindex = false, showWhatsApp = true } = Astro.props;
const hw = siteConfig.halloween;
---
<!doctype html>
<html lang="es" class="bg-stripes">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fef9f5" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <link rel="preload" href={dmSansWoff2} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo title={title} description={description} path={path} ogImage={ogImage} noindex={noindex} />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-3 focus:z-[60] focus:rounded-full focus:bg-brand-brown focus:px-4 focus:py-2 focus:text-brand-cream">
      Saltar al contenido
    </a>
    {hw.activo && path !== '' && path !== '/barra' && (
      <a href="/#promo" class="hw-aviso">
        <svg viewBox="0 0 90 40" fill="currentColor" aria-hidden="true"><path d="M45 14c-3-6-9-6-11-2-7-8-18-10-28-4 6 1 10 5 11 10 4-3 9-3 12 1 3-2 7-2 10 2 1 4 4 6 6 8 2-2 5-4 6-8 3-4 7-4 10-2 3-4 8-4 12-1 1-5 5-9 11-10-10-6-21-4-28 4-2-4-8-4-11 2z"/></svg>
        <span><b>Halloween en Brava</b> · {hw.promo.nombre} {hw.promo.precio} €</span>
        <span class="hw-aviso__ver">Ver</span>
      </a>
    )}
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    {showWhatsApp && <WhatsAppFloat />}
    {showWhatsApp && <Pedido />}
    <AnalyticsConsent />

    <!-- Reveal sutil al hacer scroll (respeta prefers-reduced-motion) -->
    <script>
      const els = document.querySelectorAll('.reveal');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
          });
        }, { threshold: 0, rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
    <style is:global>
      .hw-aviso { display: flex; align-items: center; justify-content: center; gap: .6rem; padding: .55rem 1rem; background: #1d1512; color: #fef9f5; font-size: .85rem; text-align: center; }
      .hw-aviso svg { width: 1.6rem; flex-shrink: 0; color: var(--color-brand-fresh); }
      .hw-aviso b { color: var(--color-brand-fresh); }
      .hw-aviso__ver { flex-shrink: 0; border-radius: 999px; background: var(--color-brand-fresh); color: var(--color-brand-brown); padding: .2rem .7rem; font-weight: 700; font-size: .78rem; }
    </style>
  </body>
</html>
