---
import Button from './Button.astro';
import { siteConfig, waLink, telLink } from '../../site.config';
/* ============================================================
   ToGoOrder — componente AISLADO de pedido para llevar.
   Versión 400 €: pedido por WhatsApp / teléfono (sin carrito ni pago).
   Punto de extensión limpio: si en el futuro se contrata el sistema
   de pedido online real (carrito + hora de recogida + pago), se amplía
   AQUÍ sin tocar el resto de la web. Ver NOTAS_UPSELL.md.
   ============================================================ */
interface Props { mensaje?: string; class?: string }
const { mensaje = siteConfig.toGo.mensajeWhatsApp, class: className = '' } = Astro.props;
const plataformas = siteConfig.toGo.plataformas;
const tienePlataformas = Object.values(plataformas).some(Boolean);
---
<div class={`flex flex-col items-center gap-3 sm:flex-row sm:flex-wrap ${className}`}>
  <Button href={waLink(mensaje)} variant="whatsapp" size="lg" target="_blank" ariaLabel="Pedir por WhatsApp">
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm4.52 11.86c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.98-.14.16-.29.18-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.51.11-.11.25-.29.37-.43.13-.14.17-.25.25-.41.08-.16.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.42h-.48c-.16 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.16 1.75 2.67 4.24 3.74 2.07.9 2.49.72 2.94.68.45-.04 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z"/></svg>
    Pedir por WhatsApp
  </Button>
  <Button href={telLink} variant="outline" size="lg" ariaLabel={`Llamar al ${siteConfig.telefono}`}>
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
    Llamar
  </Button>

  {tienePlataformas && (
    <div class="flex w-full flex-wrap items-center gap-2 sm:w-auto">
      {plataformas.glovo && <Button href={plataformas.glovo} variant="ghost" size="sm" target="_blank">Glovo</Button>}
      {plataformas.uberEats && <Button href={plataformas.uberEats} variant="ghost" size="sm" target="_blank">Uber Eats</Button>}
      {plataformas.justEat && <Button href={plataformas.justEat} variant="ghost" size="sm" target="_blank">Just Eat</Button>}
    </div>
  )}
</div>
