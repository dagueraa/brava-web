---
import Logo from './Logo.astro';
import { siteConfig, telLink, waLink } from '../../site.config';
import { alergenos } from '../data/menu';
const year = new Date().getFullYear();
const nav = [
  { href: '/carta', label: 'Carta' },
  { href: '/to-go', label: 'Para llevar' },
  { href: '/brava-pass', label: 'Brava Pass' },
  { href: '/historia', label: 'Historia' },
  { href: '/local', label: 'Local' },
  { href: '/contacto', label: 'Contacto' },
];
const legal = [
  { href: siteConfig.legal.aviso, label: 'Aviso legal' },
  { href: siteConfig.legal.privacidad, label: 'Privacidad' },
  { href: siteConfig.legal.cookies, label: 'Cookies' },
];
---
<footer class="mt-24 bg-brand-brown text-brand-cream">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <Logo variant="lockup" class="text-3xl text-brand-cream" />
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-brand-cream/75">
        Café de especialidad, brunch y repostería en La Ñora, Murcia. Hecho con calma y buen producto.
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2">
        <a
          href={siteConfig.redes.instagram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Instagram ${siteConfig.redes.instagramHandle}`}
          class="inline-flex items-center gap-2 text-sm font-medium text-brand-cream/85 hover:text-brand-cream"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.2c3.2 0 3.6 0 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.26.07 1.64.07 4.84s0 3.58-.07 4.84c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.26.06-1.64.07-4.85.07s-3.59 0-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.21 15.58 2.2 15.2 2.2 12s0-3.58.07-4.84c.05-1.17.25-1.81.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.43-.16 1.06-.36 2.23-.41C8.44 2.21 8.82 2.2 12 2.2Zm0 1.8c-3.14 0-3.51.01-4.75.07-1.15.05-1.77.24-2.18.4-.55.22-.94.47-1.35.88-.41.41-.66.8-.88 1.35-.16.41-.35 1.03-.4 2.18C2.39 8.49 2.4 8.86 2.4 12s-.01 3.51.04 4.75c.05 1.15.24 1.77.4 2.18.22.55.47.94.88 1.35.41.41.8.66 1.35.88.41.16 1.03.35 2.18.4 1.24.06 1.61.07 4.75.07s3.51-.01 4.75-.07c1.15-.05 1.77-.24 2.18-.4.55-.22.94-.47 1.35-.88.41-.41.66-.8.88-1.35.16-.41.35-1.03.4-2.18.06-1.24.07-1.61.07-4.75s-.01-3.51-.07-4.75c-.05-1.15-.24-1.77-.4-2.18a3.6 3.6 0 0 0-.88-1.35 3.6 3.6 0 0 0-1.35-.88c-.41-.16-1.03-.35-2.18-.4C15.51 4.01 15.14 4 12 4Zm0 3.07a4.93 4.93 0 1 1 0 9.86 4.93 4.93 0 0 1 0-9.86Zm0 1.8a3.13 3.13 0 1 0 0 6.26 3.13 3.13 0 0 0 0-6.26Zm5.13-3.27a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3Z"/>
          </svg>
          {siteConfig.redes.instagramHandle}
        </a>
        {siteConfig.redes.tiktok && (
          <a
            href={siteConfig.redes.tiktok}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`TikTok ${siteConfig.redes.tiktokHandle ?? ''}`}
            class="inline-flex items-center gap-2 text-sm font-medium text-brand-cream/85 hover:text-brand-cream"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M16.6 5.82a4.28 4.28 0 0 1-1.06-2.82h-3.05v12.17a2.5 2.5 0 0 1-2.5 2.45 2.49 2.49 0 0 1-1.16-4.7 2.49 2.49 0 0 1 1.16-.29c.26 0 .51.04.75.12v-3.1a5.55 5.55 0 0 0-.75-.05A5.57 5.57 0 0 0 5 16.96a5.57 5.57 0 0 0 9.49 3.4 5.57 5.57 0 0 0 1.56-3.86l.01-6.16a7.3 7.3 0 0 0 4.27 1.37V8.66a4.3 4.3 0 0 1-3.73-2.84Z"/>
            </svg>
            {siteConfig.redes.tiktokHandle}
          </a>
        )}
      </div>
    </div>

    <nav aria-label="Pie de página">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-brand-cream/55">Explora</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {nav.map((i) => (
          <li><a href={i.href} class="text-brand-cream/85 hover:text-brand-cream">{i.label}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-wider text-brand-cream/55">Visítanos</h2>
      <address class="mt-4 space-y-2.5 text-sm not-italic text-brand-cream/85">
        <p>{siteConfig.direccion}</p>
        <p>{siteConfig.horarioResumen}</p>
        <p><a href={telLink} class="hover:text-brand-cream">{siteConfig.telefono}</a></p>
        <p>
          <a href={waLink()} target="_blank" rel="noopener noreferrer" class="hover:text-brand-cream">Pedir por WhatsApp</a>
        </p>
      </address>
    </div>
  </div>

  <div class="border-t border-brand-cream/15">
    <div class="mx-auto max-w-6xl px-5 py-3 sm:px-6">
      <p class="text-xs leading-relaxed text-brand-cream/55">{alergenos}</p>
    </div>
  </div>

  <div class="border-t border-brand-cream/15">
    <div class="mx-auto flex max-w-6xl flex-col gap-3 px-5 py-5 text-xs text-brand-cream/55 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <p>© {year} {siteConfig.nombre}. Todos los derechos reservados.</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-1">
        {legal.map((i) => (
          <li><a href={i.href} class="hover:text-brand-cream">{i.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>
