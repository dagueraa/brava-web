---
/* Botón / CTA de marca. Variantes alineadas a la paleta del brandbook. */
interface Props {
  href?: string;
  variant?: 'primary' | 'accent' | 'outline' | 'ghost' | 'whatsapp';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  target?: string;
  rel?: string;
  ariaLabel?: string;
  type?: 'button' | 'submit';
}
const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  target,
  rel,
  ariaLabel,
  type = 'button',
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-full font-semibold transition-all duration-200 active:scale-[0.98] focus-visible:outline-none';
const sizes = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg',
};
const variants = {
  primary: 'bg-brand-brown text-brand-cream hover:bg-brand-brown-80 shadow-sm hover:shadow-md',
  accent: 'bg-brand-calm text-brand-brown hover:brightness-105 shadow-sm hover:shadow-md',
  outline: 'border-2 border-brand-brown text-brand-brown hover:bg-brand-brown hover:text-brand-cream',
  ghost: 'text-brand-brown hover:bg-brand-cream-2',
  whatsapp: 'bg-[#25D366] text-white hover:brightness-105 shadow-sm hover:shadow-md',
};
const cls = `${base} ${sizes[size]} ${variants[variant]} ${className}`;
const external = target === '_blank';
const relAttr = rel ?? (external ? 'noopener noreferrer' : undefined);
---
{href ? (
  <a href={href} class={cls} target={target} rel={relAttr} aria-label={ariaLabel}>
    <slot />
  </a>
) : (
  <button type={type} class={cls} aria-label={ariaLabel}>
    <slot />
  </button>
)}
