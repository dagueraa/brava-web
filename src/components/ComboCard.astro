---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Blob from './Blob.astro';
import HandArrow from './HandArrow.astro';
/* Tarjeta de combo destacado: foto(s) REAL(es) del producto (recorte transparente)
   flotando sobre un blob crema + flecha dibujada → nombre/precio/desc.
   Recrea fielmente la página de Combos del menú de Brava: cuando hay `coffee`,
   se compone la taza (arriba) + el producto (delante, abajo), alternando esquina. */
interface Props {
  nombre: string;
  precio: string;
  desc?: string;
  image: ImageMetadata;
  alt: string;
  coffee?: ImageMetadata; // taza que acompaña al combo (como en el menú)
  coffeeAlt?: string;
  reverse?: boolean; // alterna lado foto/texto
  index?: number;
}
const { nombre, precio, desc, image, alt, coffee, coffeeAlt, reverse = false, index = 0 } = Astro.props;
const blobVariant = ((index % 3) + 1) as 1 | 2 | 3;
---
<div class={`grid grid-cols-[minmax(0,0.95fr)_auto_minmax(0,1.05fr)] items-center gap-1.5 sm:gap-2 ${reverse ? '[direction:rtl]' : ''}`}>
  <!-- Fotos del producto flotando sobre blob -->
  <div class="relative mx-auto w-28 sm:w-52 [direction:ltr]">
    {coffee ? (
      <!-- Composición taza + producto, como en la página de Combos del menú -->
      <div class="relative aspect-square">
        <Blob class="absolute inset-0 m-auto h-full w-full text-brand-cream-2" variant={blobVariant} />
        <Image
          src={coffee}
          alt={coffeeAlt ?? 'Café de especialidad'}
          widths={[160, 240, 320]}
          sizes="(max-width: 640px) 7rem, 9rem"
          class={`absolute top-0 z-10 w-[58%] object-contain drop-shadow-[0_2px_4px_rgba(68,54,49,0.08)] ${reverse ? 'right-0' : 'left-0'}`}
          loading="lazy"
        />
        <Image
          src={image}
          alt={alt}
          widths={[192, 280, 360]}
          sizes="(max-width: 640px) 9rem, 11rem"
          class={`absolute bottom-0 z-20 w-[64%] object-contain drop-shadow-[0_3px_5px_rgba(68,54,49,0.1)] ${reverse ? 'left-0' : 'right-0'}`}
          loading="lazy"
        />
      </div>
    ) : (
      <!-- Una sola foto -->
      <div class="relative grid place-items-center">
        <Blob class="absolute inset-0 m-auto h-[88%] w-[88%] text-brand-cream-2" variant={blobVariant} />
        <Image
          src={image}
          alt={alt}
          widths={[192, 280, 360]}
          sizes="(max-width: 640px) 12rem, 15rem"
          class="relative w-full object-contain drop-shadow-[0_10px_18px_rgba(68,54,49,0.18)]"
          loading="lazy"
        />
      </div>
    )}
  </div>

  <!-- Flecha dibujada (también en móvil, como el menú) -->
  <HandArrow class="h-8 w-10 text-brand-brown-60 sm:h-12 sm:w-24 [direction:ltr]" flip={reverse} />

  <!-- Texto -->
  <div class="[direction:ltr]">
    <div class="flex flex-wrap items-baseline gap-x-2 sm:gap-x-3">
      <h3 class="text-lg font-bold text-brand-brown sm:text-2xl">{nombre}</h3>
      <span class="text-base font-bold text-brand-brown sm:text-xl">{precio} €</span>
    </div>
    {desc && <p class="mt-1 text-sm text-brand-brown-80 italic sm:text-base">{desc}</p>}
  </div>
</div>
