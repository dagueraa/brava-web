---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import BlackWeek from '../components/BlackWeek.astro';
import { siteConfig } from '../../site.config';
import { fechasPromo } from '../data/promo';
/* Página de la promoción: la misma sección que en la portada, con su propia URL para
   compartirla (Instagram, WhatsApp, carteles). */
const p = siteConfig.promo;
---
<Base title={`${p.nombre}: 2x1 en combos`} description={`${p.nombre} en Brava: dos combos al precio de uno ${fechasPromo}, solo pidiendo por la web con el código ${p.codigo}.`} path="/black-week" ogImage="/promo/black-week-post-cafe.jpg">
  <div class="pt-8 pb-4 sm:pt-12">
    <BlackWeek as="h1" />
  </div>
  <Section class="pb-20 text-center">
    <p class="text-brand-brown-80">
      ¿Estudiante? <a href="/comparte" class="font-bold text-brand-brown underline underline-offset-4">Comparte el cartel y te invitamos a {p.recompensaComparte} →</a>
    </p>
  </Section>
</Base>
