---
import Base from '../layouts/Base.astro';
import Blob from '../components/Blob.astro';
import Logo from '../components/Logo.astro';
import { siteConfig } from '../../site.config';
---

<Base
  title="Campaña de Instagram"
  description="Descubre la campaña de Brava, mira el vídeo y participa a través de nuestro Instagram."
  path="/instagram"
  noindex={true}
  showWhatsApp={false}
>
  <section class="relative isolate overflow-hidden px-5 pb-8 pt-10 sm:px-6 sm:pb-14 sm:pt-16">
    <Blob class="-left-36 -top-40 -z-10 h-[28rem] w-[28rem] text-brand-calm/25" variant={2} />
    <Blob class="-bottom-40 -right-40 -z-10 h-[30rem] w-[30rem] text-brand-fresh/30" variant={3} />

    <div class="mx-auto grid max-w-5xl items-center gap-9 lg:grid-cols-[minmax(0,1fr)_minmax(20rem,26rem)] lg:gap-16">
      <div class="text-center lg:text-left">
        <div class="inline-flex items-center gap-2 rounded-full border border-brand-brown/15 bg-brand-cream-2/75 px-4 py-2 text-xs font-bold uppercase tracking-[0.14em] text-brand-brown-80">
          <span class="h-2 w-2 rounded-full bg-brand-fresh ring-2 ring-brand-brown/10"></span>
          Campaña exclusiva en el local
        </div>

        <div class="mt-7">
          <Logo class="text-[2.2rem] text-brand-brown" />
        </div>
        <h1 class="mx-auto mt-5 max-w-2xl text-4xl font-bold text-brand-brown sm:text-5xl lg:mx-0 lg:text-[3.6rem]">
          Manolo ya tiene su café gratis.
          <span class="mt-2 block font-hand text-[1.12em] font-semibold leading-none text-brand-calm-ink">Ahora te toca a ti.</span>
        </h1>
        <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-brand-brown-80 sm:text-lg lg:mx-0">
          Dale al play para descubrir cómo participar. Después, entra en nuestro Instagram y sigue las instrucciones.
        </p>

        <div class="mt-7 hidden items-center gap-3 text-sm font-semibold text-brand-brown-80 lg:flex">
          <span class="rounded-full bg-brand-fresh px-4 py-2 text-brand-brown">25 cafés gratis</span>
          <span class="rounded-full bg-brand-calm px-4 py-2 text-brand-brown">25 códigos 2×1</span>
        </div>
      </div>

      <div class="mx-auto w-full max-w-[26rem]">
        <div class="relative">
          <div class="absolute -inset-3 -z-10 rotate-2 rounded-[2.4rem] bg-brand-calm/35 sm:-inset-4"></div>
          <div class="overflow-hidden rounded-[2rem] border-[5px] border-brand-brown bg-brand-brown shadow-[0_24px_60px_rgba(68,54,49,0.22)]">
            <video
              class="aspect-[3/4] w-full bg-brand-brown object-cover"
              controls
              playsinline
              preload="metadata"
              poster="/media/campana-instagram-poster.webp"
              aria-label="Vídeo con las instrucciones para participar en la campaña de Brava"
            >
              <source src="/media/campana-instagram.mp4" type="video/mp4" />
              Tu navegador no puede reproducir este vídeo.
            </video>
          </div>
        </div>

        <div class="mt-7 flex flex-col items-center">
          <a
            href={siteConfig.redes.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="instagram-cta group inline-flex min-h-14 w-full items-center justify-center gap-3 rounded-full bg-brand-brown px-7 py-4 text-base font-bold text-brand-cream shadow-lg transition hover:-translate-y-0.5 hover:bg-brand-brown-80 hover:shadow-xl sm:text-lg"
            aria-label={`Ir al Instagram de Brava ${siteConfig.redes.instagramHandle}`}
          >
            <svg class="h-6 w-6 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.2c3.2 0 3.6 0 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.26.07 1.64.07 4.84s0 3.58-.07 4.84c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.26.06-1.64.07-4.85.07s-3.59 0-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.21 15.58 2.2 15.2 2.2 12s0-3.58.07-4.84c.05-1.17.25-1.81.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.43-.16 1.06-.36 2.23-.41C8.44 2.21 8.82 2.2 12 2.2Zm0 1.8c-3.14 0-3.51.01-4.75.07-1.15.05-1.77.24-2.18.4-.55.22-.94.47-1.35.88-.41.41-.66.8-.88 1.35-.16.41-.35 1.03-.4 2.18C2.39 8.49 2.4 8.86 2.4 12s-.01 3.51.04 4.75c.05 1.15.24 1.77.4 2.18.22.55.47.94.88 1.35.41.41.8.66 1.35.88.41.16 1.03.35 2.18.4 1.24.06 1.61.07 4.75.07s3.51-.01 4.75-.07c1.15-.05 1.77-.24 2.18-.4.55-.22.94-.47 1.35-.88.41-.41.66-.8.88-1.35.16-.41.35-1.06.4-2.18.06-1.24.07-1.61.07-4.75s-.01-3.51-.07-4.75c-.05-1.15-.24-1.77-.4-2.18a3.6 3.6 0 0 0-.88-1.35 3.6 3.6 0 0 0-1.35-.88c-.41-.16-1.03-.35-2.18-.4C15.51 4.01 15.14 4 12 4Zm0 3.07a4.93 4.93 0 1 1 0 9.86 4.93 4.93 0 0 1 0-9.86Zm0 1.8a3.13 3.13 0 1 0 0 6.26 3.13 3.13 0 0 0 0-6.26Zm5.13-3.27a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3Z" />
            </svg>
            Ir a {siteConfig.redes.instagramHandle}
            <svg class="h-5 w-5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
          <p class="mt-3 text-center text-xs font-medium text-brand-brown-60">Tu código caduca en 48 h.</p>
        </div>

        <div class="mt-6 flex flex-wrap justify-center gap-2 text-xs font-bold text-brand-brown lg:hidden">
          <span class="rounded-full bg-brand-fresh px-3.5 py-2">25 cafés gratis</span>
          <span class="rounded-full bg-brand-calm px-3.5 py-2">25 códigos 2×1</span>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .instagram-cta {
    position: relative;
    isolation: isolate;
  }

  .instagram-cta::before {
    position: absolute;
    inset: -4px;
    z-index: -1;
    border-radius: 9999px;
    background: linear-gradient(110deg, var(--color-brand-fresh), var(--color-brand-calm));
    content: '';
    opacity: 0.78;
  }
</style>
