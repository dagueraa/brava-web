---
import { rutasIdioma } from '../../i18n';
export const getStaticPaths = rutasIdioma;
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
import LocationBlock from '../../components/LocationBlock.astro';
import { siteConfig, telLink, waLink, textosEn } from '../../../site.config';
import { useLang } from '../../i18n';
const { t } = useLang(Astro.url);

const canales = [
  {
    t: 'WhatsApp',
    d: t('La forma más rápida de pedir o consultar.', 'The quickest way to order or ask us anything.'),
    href: waLink(t(siteConfig.toGo.mensajeWhatsApp, textosEn.mensajeWhatsApp)),
    cta: t('Escríbenos', 'Message us'),
    variant: 'whatsapp' as const,
    target: '_blank',
  },
  {
    t: t('Teléfono', 'Phone'),
    d: siteConfig.telefono,
    href: telLink,
    cta: t('Llamar', 'Call'),
    variant: 'primary' as const,
  },
  {
    t: 'Instagram',
    d: siteConfig.redes.instagramHandle,
    href: siteConfig.redes.instagram,
    cta: t('Síguenos', 'Follow us'),
    variant: 'outline' as const,
    target: '_blank',
  },
  {
    t: 'TikTok',
    d: siteConfig.redes.tiktokHandle,
    href: siteConfig.redes.tiktok,
    cta: t('Síguenos', 'Follow us'),
    variant: 'outline' as const,
    target: '_blank',
  },
];
---
<Base title={t('Contacto', 'Contact')} description={t('Contacta con Brava: WhatsApp, teléfono, Instagram, TikTok y ubicación en La Ñora, Murcia.', 'Get in touch with Brava: WhatsApp, phone, Instagram, TikTok and how to find us in La Ñora, Murcia.')} path="/contacto">
  <Section class="pt-12 pb-8 text-center">
    <h1 class="text-4xl font-bold text-brand-brown sm:text-5xl">{t('Hablemos', 'Let’s talk')}</h1>
    <p class="mx-auto mt-3 max-w-md text-brand-brown-80">
      {t('¿Una duda, un pedido para llevar o solo saludar? Estamos a un mensaje de distancia.', 'A question, a takeaway order or just saying hi? We’re only a message away.')}
    </p>
  </Section>

  <Section class="pb-12">
    <div class="grid gap-5 sm:grid-cols-3">
      {canales.map((c) => (
        <div class="flex flex-col items-center rounded-3xl border rule-soft bg-brand-cream-2/40 p-7 text-center">
          <h2 class="text-xl font-bold text-brand-brown">{c.t}</h2>
          <p class="mt-1 mb-5 flex-1 text-sm text-brand-brown-80">{c.d}</p>
          <Button href={c.href} variant={c.variant} target={c.target}>{c.cta}</Button>
        </div>
      ))}
    </div>
  </Section>

  <Section width="wide" class="pb-16">
    <LocationBlock />
  </Section>
</Base>
