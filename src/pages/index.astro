---
import Base from '../layouts/Base.astro';
import Resenas from '../components/Resenas.astro';
import Logo from '../components/Logo.astro';
import BrandIcon from '../components/BrandIcon.astro';
import Blob from '../components/Blob.astro';
import HandArrow from '../components/HandArrow.astro';
import Plato from '../components/Plato.astro';
import BotonPedido from '../components/BotonPedido.astro';
import { anadible, extraDeNota } from '../data/pedido';
import { Image } from 'astro:assets';
import { img } from '../assets/images';
import { menuFotos, type MenuFotoKey } from '../assets/menuImages';
import { categorias, type MenuItem } from '../data/menu';
import { siteConfig, waLink } from '../../site.config';
import photocall from '../assets/halloween/photocall.jpg';
import promoRender from '../assets/halloween/promo-render.png';

/* Todos los platos y precios salen de la carta oficial (src/data/menu.ts). */
const todos: MenuItem[] = categorias.flatMap((c) => [
  ...(c.items ?? []),
  ...(c.subsecciones?.flatMap((s) => s.items) ?? []),
  ...(c.especiales?.items ?? []),
]);
const plato = (nombre: string) => {
  const it = todos.find((i) => i.nombre === nombre);
  if (!it) throw new Error(`No está en la carta: ${nombre}`);
  return it;
};
const combos = categorias.find((c) => c.id === 'combos')!;
// cada plato con su apartado de la carta, para añadirlo al pedido con el mismo id que en /carta
const conApartado = categorias.flatMap((c) => [
  ...(c.items ?? []).map((i) => ({ i, ap: '' })),
  ...(c.subsecciones?.flatMap((s) => s.items.map((i) => ({ i, ap: s.titulo }))) ?? []),
  ...(c.especiales?.items.map((i) => ({ i, ap: c.especiales!.titulo })) ?? []),
]);
const zumo = extraDeNota(combos.nota);
const paraPedido = (it?: MenuItem) => {
  if (!it) return undefined;
  const x = conApartado.find((e) => e.i === it)!;
  return anadible(it, x.ap, combos.items!.includes(it) ? zumo : undefined);
};
// plato de la carta que corresponde a cada foto (para abrirlo de cerca con su nombre y precio)
const slug = (t: string) => t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/\s+/g, '-');
const porFoto = (k: MenuFotoKey) => todos.find((i) => i.foto === k) ?? todos.find((i) => slug(i.nombre) === k);

const panels = [
  {
    suffix: 'drinks', fondo: 'bg-brand-calm', tinta: 'text-brand-brown', kicker: 'Para beber despacio',
    fotos: ['iced-brava', 'blue-matcha', 'cafe-amarillo'] as MenuFotoKey[],
    platos: ['Iced Brava', 'Blue Matcha', 'Brava Coffee', 'Matcha Latte Pistacho', 'Pink Latte'].map(plato),
    href: '/carta#drinks',
  },
  {
    suffix: 'brunch', fondo: 'bg-brand-cream-2', tinta: 'text-brand-brown', kicker: 'Al momento',
    fotos: ['esp-salmone-brioche', 'esp-mortadella-bagel', 'focaccia-pompeyana'] as MenuFotoKey[],
    platos: ['Salmone Brioche', 'Mortadella Bagel', 'Focaccia Pompeyana', 'Brava Brioche'].map(plato),
    href: '/carta#brunch',
  },
  {
    suffix: 'treats', fondo: 'bg-brand-fresh', tinta: 'text-brand-brown', kicker: 'El capricho',
    fotos: ['brava-pop', 'esp-pistachio', 'focaccia-lotus'] as MenuFotoKey[],
    platos: ['Brava Pop', 'Pistachio Brioche', 'Focaccia Lotus', 'Nutella Brioche'].map(plato),
    href: '/carta#treats',
  },
];

const lattes = ['Caramelo Salado', 'Vainilla', 'Avellana Tostada', 'Pistacho'].map(plato);
const clasicos = ['Espresso', 'Flat White', 'Cappuccino'].map(plato);
const frase = ['café de especialidad', 'brunch', 'treats', 'para llevar', 'La Ñora'];
const iconosFranja = ['croissant', 'cafe', 'cookie', 'smoothie', 'muffin'] as const;
const objetivo = siteConfig.bravaPass.objetivo;

/* ---------- Halloween ---------- */
const hw = siteConfig.halloween;
const promoPedido = { id: 'halloween-promo', nombre: hw.promo.nombre, precio: Math.round(parseFloat(hw.promo.precio.replace(',', '.')) * 100) };
const igCampana = hw.instagramCampana.replace('@', '');
// telaraña de la esquina (como la del photocall): radios desde la esquina y anillos combados
const tela = (() => {
  const C = [300, 0], radios = 7, anillos = 6;
  const ang = Array.from({ length: radios }, (_, i) => Math.PI / 2 + (i / (radios - 1)) * (Math.PI / 2));
  const pt = (a: number, r: number) => [C[0] + Math.cos(a) * r, C[1] + Math.sin(a) * r];
  let d = ang.map((a) => { const [x, y] = pt(a, 290); return `M${C[0]} ${C[1]}L${x.toFixed(1)} ${y.toFixed(1)}`; }).join('');
  for (let k = 1; k <= anillos; k++) {
    const r = k * 44;
    ang.forEach((a, i) => {
      if (i === 0) { const [x, y] = pt(a, r); d += `M${x.toFixed(1)} ${y.toFixed(1)}`; return; }
      const am = (a + ang[i - 1]) / 2;
      const [cx, cy] = pt(am, r * 0.84);
      const [x, y] = pt(a, r);
      d += `Q${cx.toFixed(1)} ${cy.toFixed(1)} ${x.toFixed(1)} ${y.toFixed(1)}`;
    });
  }
  return d;
})();
const franjaHw = ['un café de miedo', 'halloween en brava', 'photocall', `latte + cookie ${hw.promo.precio} €`, 'La Ñora'];
const iconosHw = ['cafe', 'cookie', 'taza', 'muffin', 'croissant'] as const;

---
<Base title="Halloween en Brava" description={`Halloween en Brava: ${hw.lema} Latte macchiato + cookie especial Halloween por ${hw.promo.precio} € y nuestro photocall de Halloween en La Ñora.`} path="">
  <!-- ═════════ 1 · LA NOCHE (escena 3D coreografiada con el scroll) ═════════ -->
  <section id="noche" class="noche" aria-label={`Halloween en Brava. ${hw.lema}`}>
    <div class="noche__stage">
      <div class="noche__cielo" aria-hidden="true"><i class="noche__luna"></i><i class="noche__estrellas"></i></div>
      <div class="noche__word" aria-hidden="true">halloween</div>
      <canvas id="noche3d" class="noche__canvas" aria-hidden="true"></canvas>
      <div class="noche__niebla" aria-hidden="true"><i></i><i></i></div>
      <svg class="noche__tela" viewBox="0 0 300 300" aria-hidden="true"><path d={tela} /></svg>
      <div class="noche__arana" aria-hidden="true">
        <i class="noche__hilo"></i>
        <svg viewBox="-30 -26 60 52"><g class="patas" stroke="currentColor" stroke-width="2.6" fill="none" stroke-linecap="round"><path d="M-6 -4 Q-18 -18 -26 -8M-6 0 Q-20 -6 -28 4M-6 3 Q-18 8 -25 18M-5 6 Q-12 16 -16 24M6 -4 Q18 -18 26 -8M6 0 Q20 -6 28 4M6 3 Q18 8 25 18M5 6 Q12 16 16 24"/></g><ellipse cx="0" cy="2" rx="9" ry="11" fill="currentColor"/><circle cx="0" cy="-9" r="6" fill="currentColor"/><circle cx="-2.4" cy="-10" r="1.6" fill="#fef9f5"/><circle cx="2.4" cy="-10" r="1.6" fill="#fef9f5"/></svg>
      </div>

      <!-- Paso 0 -->
      <div class="noche__step noche__step--intro" data-from="0" data-to="0.18">
        <p class="noche__kicker"><Logo class="text-[1.1em]" /> <span>coffee and brunch · {siteConfig.ciudad}</span></p>
        <h1 class="noche__h1">
          <span class="noche__hw">Halloween</span>
          <span class="noche__lema">{hw.lema}<svg viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true"><path d="M4 14 Q 80 4 150 10 T 296 8" /></svg></span>
        </h1>
        <div class="noche__ctas">
          <a href="#promo" class="btn-e btn-e--fresh">La promo de miedo</a>
          <a href="#photocall" class="btn-e btn-e--ghost">El photocall</a>
        </div>
      </div>
      <!-- Paso 1: vista cenital (telaraña + cookie) -->
      <div class="noche__step noche__step--bottom" data-from="0.3" data-to="0.54">
        <p class="font-hand text-3xl text-brand-fresh sm:text-4xl">latte de telaraña</p>
        <h2 class="noche__h2">{hw.promo.nombre}</h2>
        <div class="mt-4 flex flex-wrap items-center justify-center gap-4">
          <p class="noche__precio">{hw.promo.precio}<span>€</span></p>
          <BotonPedido a={promoPedido} texto="Añadir al pedido" class="!bg-brand-fresh !text-brand-brown" />
        </div>
      </div>
      <!-- Paso 2: el fantasma sale a saludar -->
      <div class="noche__step noche__step--left" data-from="0.74" data-to="1.01">
        <p class="font-hand text-3xl text-brand-fresh sm:text-4xl">él ya está listo para la foto</p>
        <h2 class="noche__h2">¿Y tú?</h2>
        <p class="noche__p">Ven a hacerte la foto en nuestro photocall de Halloween. Y si lo tocas, a lo mejor se asusta.</p>
        <div class="noche__ctas !justify-start"><a href="#photocall" class="btn-e btn-e--fresh">Ver el photocall</a></div>
      </div>

      <!-- La linterna: la página empieza a oscuras -->
      <div id="linterna" class="linterna" aria-hidden="true">
        <p class="linterna__txt"><span class="font-hand">está muy oscuro…</span><b>Mueve la linterna</b></p>
        <button type="button" class="linterna__btn" tabindex="-1">Encender las velas</button>
      </div>
      <div class="noche__bar" aria-hidden="true"><i></i></div>
    </div>
  </section>

  <!-- ═════════ 2 · FRANJAS ═════════ -->
  <section class="franjas franjas--hw" aria-label={`${hw.lema} Halloween en Brava, photocall y promo de latte y cookie`}>
    <div class="franja franja--fresh"><div class="franja__track" data-dir="-1">
      {Array.from({ length: 2 }).map(() => (
        <div class="franja__group" aria-hidden="true">
          {Array.from({ length: 3 }).flatMap(() => franjaHw).map((f, i) => (
            <><span>{f}</span><BrandIcon name={iconosHw[i % iconosHw.length]} class="h-9 w-9 shrink-0 sm:h-11 sm:w-11" /></>
          ))}
        </div>
      ))}
    </div></div>
    <div class="franja franja--caramelo"><div class="franja__track" data-dir="1">
      {Array.from({ length: 2 }).map(() => (
        <div class="franja__group" aria-hidden="true">
          {Array.from({ length: 4 }).flatMap(() => ['¿truco o trato?', 'un café de miedo', '¡bu!']).map((f) => (
            <><span class="font-hand !font-semibold normal-case !tracking-normal">{f}</span><svg class="h-6 w-9 shrink-0" viewBox="0 0 90 40" fill="currentColor"><path d="M45 14c-3-6-9-6-11-2-7-8-18-10-28-4 6 1 10 5 11 10 4-3 9-3 12 1 3-2 7-2 10 2 1 4 4 6 6 8 2-2 5-4 6-8 3-4 7-4 10-2 3-4 8-4 12-1 1-5 5-9 11-10-10-6-21-4-28 4-2-4-8-4-11 2z"/></svg></>
          ))}
        </div>
      ))}
    </div></div>
  </section>

  <!-- ═════════ 3 · CUENTA ATRÁS ═════════ -->
  <section id="cuenta" class="cuenta" data-noche={hw.noche} aria-label="Cuenta atrás para la noche de Halloween">
    <p class="font-hand text-3xl text-brand-fresh sm:text-4xl">la noche de Halloween llega en</p>
    <div class="cuenta__digitos" role="timer" aria-live="off">
      {[['d', 'días'], ['h', 'horas'], ['m', 'minutos'], ['s', 'segundos']].map(([k, t]) => (
        <div class="cuenta__bloque"><span class="cuenta__num" data-k={k}>00</span><small>{t}</small></div>
      ))}
    </div>
    <p class="cuenta__hoy" hidden>¡Hoy es Halloween! Te esperamos en Brava.</p>
  </section>

  <!-- ═════════ 4 · LA PROMO ═════════ -->
  <section id="promo" class="promo">
    <div class="promo__ilus">
      <div class="promo__halo" aria-hidden="true"></div>
      <Image src={promoRender} alt={`${hw.promo.nombre}: vaso Brava con latte art de telaraña y cookie con cara de calabaza`} widths={[420, 640, 900]} sizes="(max-width: 768px) 88vw, 520px" class="promo__foto" loading="lazy" />
      <span class="promo__sello" aria-hidden="true">{hw.promo.precio}<small>€</small></span>
      {[0, 1, 2].map((i) => <svg class={`promo__bat promo__bat--${i}`} viewBox="0 0 90 40" fill="currentColor" aria-hidden="true"><path d="M45 14c-3-6-9-6-11-2-7-8-18-10-28-4 6 1 10 5 11 10 4-3 9-3 12 1 3-2 7-2 10 2 1 4 4 6 6 8 2-2 5-4 6-8 3-4 7-4 10-2 3-4 8-4 12-1 1-5 5-9 11-10-10-6-21-4-28 4-2-4-8-4-11 2z"/></svg>)}
    </div>
    <div class="promo__txt">
      <p class="font-hand text-3xl text-brand-fresh sm:text-4xl">la promo de Halloween</p>
      <h2 class="promo__h2">{hw.promo.nombre}</h2>
      <p class="promo__frase">«{hw.promo.frase}»</p>
      <div class="mt-7 flex flex-wrap items-center gap-5">
        <p class="noche__precio">{hw.promo.precio}<span>€</span></p>
        <BotonPedido a={promoPedido} texto="Añadir al pedido" class="!bg-brand-fresh !text-brand-brown" />
      </div>
      <p class="mt-4 text-sm text-brand-cream/60">En barra o para llevar.</p>
    </div>
  </section>

  <!-- ═════════ 5 · EL PHOTOCALL ═════════ -->
  <section id="photocall" class="photocall">
    <div class="photocall__foto" id="pc-foto">
      <span class="photocall__cinta photocall__cinta--1" aria-hidden="true"></span>
      <span class="photocall__cinta photocall__cinta--2" aria-hidden="true"></span>
      <Image src={photocall} alt="El photocall de Halloween de Brava: fantasma, calabazas sonrientes, murciélagos y globos color caramelo" widths={[420, 640, 900]} sizes="(max-width: 768px) 82vw, 440px" class="block w-full rounded-[.4rem]" loading="lazy" />
      <div class="photocall__oscuro" aria-hidden="true"></div>
      <p class="photocall__pie font-hand">{hw.lema}</p>
    </div>
    <div class="photocall__txt">
      <p class="font-hand text-3xl text-brand-fresh sm:text-4xl">photocall de Halloween</p>
      <h2 class="promo__h2">Hazte la foto más de miedo de La Ñora.</h2>
      <ol class="photocall__pasos">
        <li><b>1</b><span>Ven a Brava y hazte la foto con el fantasma y las calabazas.</span></li>
        <li><b>2</b><span>Súbela a tus redes y etiqueta a <strong>{hw.instagramCampana}</strong>.</span></li>
        {hw.concurso.activo && <li><b>3</b><span><strong>Entras en el sorteo de {hw.concurso.premio}.</strong> {hw.concurso.texto}</span></li>}
      </ol>
      <a href={`https://www.instagram.com/${igCampana}/`} target="_blank" rel="noopener noreferrer" class="btn-e btn-e--fresh mt-8">Abrir Instagram</a>
    </div>
  </section>


  <!-- ═════════ 4 · LA CARTA EN HORIZONTAL ═════════ -->
  <section class="hcarta" aria-label="La carta de Brava">
    <div class="hcarta__stage">
      <div class="hcarta__head">
        <p class="font-hand text-3xl text-brand-calm-ink">y para acompañar el susto</p>
        <h2 class="text-3xl font-bold text-brand-brown sm:text-5xl">La carta de siempre.</h2>
      </div>
      <div class="hcarta__track">
        {panels.map((p, i) => (
          <article class={`hpanel ${p.fondo} ${p.tinta}`}>
            <div class="hpanel__fotos">
              {p.fotos.map((f, k) => (
                <div class={`hpanel__foto hpanel__foto--${k}`} data-par={(k + 1) * (i % 2 ? -1 : 1)}>
                  <Plato foto={f} alt={porFoto(f)?.nombre ?? 'Café de especialidad'} nombre={porFoto(f)?.nombre} precio={porFoto(f)?.precio} desc={porFoto(f)?.desc} a={paraPedido(porFoto(f))} widths={[240, 400, 560]} sizes="(max-width: 768px) 38vw, 300px" />
                </div>
              ))}
            </div>
            <div class="hpanel__txt">
              <p class="font-hand text-2xl opacity-80 sm:text-3xl">{p.kicker}</p>
              <Logo as="h3" suffix={p.suffix} class="text-4xl sm:text-5xl" />
              <ul class="hpanel__lista">
                {p.platos.map((pl) => (
                  <li><span><b>{pl.nombre}</b>{pl.desc && <small>{pl.desc}</small>}</span><em>{pl.precio} €</em><BotonPedido a={paraPedido(pl)!} class="hpanel__mas" /></li>
                ))}
              </ul>
              <a href={p.href} class="btn-e btn-e--brown mt-5">Ver {p.suffix}</a>
            </div>
          </article>
        ))}
        <article class="hpanel hpanel--fin bg-brand-brown text-brand-cream">
          <BrandIcon name="bolsa" class="h-24 w-24 text-brand-fresh" />
          <Logo as="h3" suffix="to go" class="mt-5 text-4xl text-brand-cream sm:text-5xl" />
          <p class="mt-3 max-w-xs text-brand-cream/80">Pídelo por WhatsApp y pásate a recogerlo en {siteConfig.toGo.tiempoPreparacionMin} minutos.</p>
          <div class="mt-6 flex flex-wrap justify-center gap-3">
            <a href="/carta" class="btn-e btn-e--fresh">Carta completa</a>
            <a href="/to-go" class="btn-e btn-e--ghost">Para llevar</a>
          </div>
        </article>
      </div>
      <div class="hcarta__bar" aria-hidden="true"><i></i></div>
    </div>
  </section>


  <!-- ═════════ 7 · VEN A VERNOS ═════════ -->
  <section class="mx-auto w-full max-w-6xl px-5 pb-20 sm:px-6">
    <div class="visita">
      <Image src={img.entrada} alt="Entrada de Brava: rótulo brava sobre la pared vegetal" widths={[480, 800, 1100]} sizes="(max-width: 768px) 100vw, 560px" class="visita__foto" loading="lazy" />
      <div class="visita__txt">
        <p id="abierto" class="visita__estado"><i></i><span>Horario</span></p>
        <h2 class="mt-4 text-4xl font-bold text-brand-cream sm:text-5xl">Te esperamos en La Ñora.</h2>
        <p class="mt-3 text-lg text-brand-cream/80">{siteConfig.direccion}</p>
        <dl class="visita__horario">
          {Object.entries(siteConfig.horario).map(([d, h]) => (
            <div data-dia={d}><dt>{d === 'miercoles' ? 'miércoles' : d === 'sabado' ? 'sábado' : d}</dt><dd>{h}</dd></div>
          ))}
        </dl>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={siteConfig.mapsUrl} target="_blank" rel="noopener noreferrer" class="btn-e btn-e--fresh">Cómo llegar</a>
          <a href={waLink('¡Hola Brava!')} target="_blank" rel="noopener noreferrer" class="btn-e btn-e--ghost">WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <button id="ambiente" class="ambiente" type="button" aria-pressed="false" aria-label="Activar o quitar el sonido de ambiente">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z" fill="currentColor"/><path class="ondas" d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/></svg>
    <span>Sonido de miedo</span>
  </button>
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  /* Avance (0–1) de una sección alta mientras su escenario está fijo en pantalla.
     Se mide con el escenario real (alto y margen superior del sticky), no con la ventana,
     y la animación acaba al 88 %: el último estado se queda quieto antes de soltarse. */
  const FIN = 0.88;
  const escenarios = new Map<HTMLElement, HTMLElement | null>();
  const avance = (el: HTMLElement) => {
    if (!escenarios.has(el)) escenarios.set(el, el.querySelector<HTMLElement>(':scope > [class$="__stage"]'));
    const st = escenarios.get(el);
    const fijo = st && getComputedStyle(st).position === 'sticky';
    const arriba = fijo ? parseFloat(getComputedStyle(st!).top) || 0 : 0;
    const recorrido = el.offsetHeight - (fijo ? st!.offsetHeight : window.innerHeight);
    const r = el.getBoundingClientRect();
    return recorrido > 0 ? clamp((arriba - r.top) / recorrido / FIN) : 0;
  };


  /* ---------- 1 · la noche ---------- */
  const noche = document.getElementById('noche')!;
  const canvas = document.getElementById('noche3d') as HTMLCanvasElement;
  const steps = [...noche.querySelectorAll<HTMLElement>('.noche__step')];
  const bar = noche.querySelector<HTMLElement>('.noche__bar i')!;
  const word = noche.querySelector<HTMLElement>('.noche__word')!;
  const arana = noche.querySelector<HTMLElement>('.noche__arana')!;
  let escena: { setProgress(p: number): void; setTilt(x: number, y: number): void } | null = null;

  const webgl = (() => { try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; } })();
  if (webgl && !reduce) {
    const arrancar = () => import('../scripts/noche3d').then(({ crearNoche }) =>
      crearNoche(canvas, { onReady: () => noche.classList.add('is-3d') }).then((e) => { escena = e; pintarNoche(); }),
    ).catch(() => noche.classList.add('no-3d'));
    'requestIdleCallback' in window ? requestIdleCallback(arrancar, { timeout: 900 }) : setTimeout(arrancar, 300);
    window.addEventListener('deviceorientation', (e) => {
      if (e.gamma == null || e.beta == null) return;
      escena?.setTilt(clamp((e.gamma + 30) / 60) * 2 - 1, clamp((e.beta - 20) / 60) * 2 - 1);
    }, { passive: true });
  } else {
    noche.classList.add('no-3d');
  }

  function pintarNoche() {
    const p = avance(noche);
    escena?.setProgress(p);
    bar.style.transform = `scaleX(${p})`;
    word.style.transform = `translate(-50%, -50%) scale(${1 + p * 0.35})`;
    // la araña baja con el scroll (y sube del todo al final)
    const bajada = clamp(p / 0.12) * (1 - clamp((p - 0.18) / 0.1)); // solo al principio: luego deja ver el latte y al fantasma
    arana.style.setProperty('--hilo', `${Math.round(40 + bajada * (innerWidth < 768 ? 150 : 250))}px`);
    steps.forEach((s) => {
      const a = parseFloat(s.dataset.from!), b = parseFloat(s.dataset.to!);
      const fin = b > 1 ? 1 : clamp((b - p) / 0.04);
      const k = Math.min(a === 0 ? 1 : clamp((p - a) / 0.04), fin);
      s.style.opacity = String(k);
      s.style.transform = `translateY(${(1 - k) * 24}px)`;
      s.style.visibility = k < 0.01 ? 'hidden' : 'visible';
    });
  }
  // la araña: si la tocas, sube corriendo
  arana.addEventListener('click', () => { arana.classList.add('huye'); setTimeout(() => arana.classList.remove('huye'), 2600); });

  /* ---------- la linterna ---------- */
  const lint = document.getElementById('linterna')!;
  let encendida = false;
  const encender = () => {
    if (encendida) return;
    encendida = true;
    lint.classList.add('fuera');
    setTimeout(() => lint.remove(), 1400);
  };
  if (reduce || sessionStorage.getItem('hw.luz')) { lint.remove(); encendida = true; }
  else {
    sessionStorage.setItem('hw.luz', '1');
    const mover = (x: number, y: number) => { lint.style.setProperty('--lx', `${x}px`); lint.style.setProperty('--ly', `${y}px`); };
    lint.addEventListener('pointermove', (e) => { const r = lint.getBoundingClientRect(); mover(e.clientX - r.left, e.clientY - r.top); lint.classList.add('movida'); });
    // en el móvil (o si nadie la mueve) la linterna busca sola
    const t0 = performance.now();
    const vagar = () => {
      if (encendida) return;
      if (!lint.classList.contains('movida')) {
        const t = (performance.now() - t0) / 1000, r = lint.getBoundingClientRect();
        mover(r.width * (0.5 + 0.3 * Math.sin(t * 0.9)), r.height * (0.45 + 0.22 * Math.sin(t * 1.3 + 1)));
      }
      requestAnimationFrame(vagar);
    };
    vagar();
    lint.querySelector('button')!.addEventListener('click', encender);
    lint.addEventListener('click', (e) => { if ((e.target as HTMLElement).tagName !== 'BUTTON' && matchMedia('(pointer: coarse)').matches) encender(); });
    window.addEventListener('scroll', () => { if (scrollY > 40) encender(); }, { passive: true });
    setTimeout(encender, 9000);
  }

  /* ---------- 3 · cuenta atrás (hora de Madrid) ---------- */
  (() => {
    const sec = document.getElementById('cuenta')!;
    const [Y, M, D] = sec.dataset.noche!.split('-').map(Number);
    const objetivo = Date.UTC(Y, M - 1, D, 0, 0, 0) - 60 * 60 * 1000; // 00:00 en Madrid (horario de invierno, UTC+1)
    const finDia = objetivo + 24 * 3600 * 1000;
    const nums = Object.fromEntries([...sec.querySelectorAll<HTMLElement>('[data-k]')].map((n) => [n.dataset.k, n]));
    const pon = (k: string, v: number) => { const t = String(v).padStart(2, '0'); if (nums[k].textContent !== t) { nums[k].textContent = t; nums[k].classList.remove('gira'); void nums[k].offsetWidth; nums[k].classList.add('gira'); } };
    const tic = () => {
      const ahora = Date.now();
      if (ahora >= objetivo) {
        sec.querySelector('.cuenta__digitos')!.toggleAttribute('hidden', true);
        const hoy = sec.querySelector<HTMLElement>('.cuenta__hoy')!;
        hoy.hidden = ahora >= finDia;
        if (ahora >= finDia) sec.hidden = true;
        return;
      }
      let s = Math.floor((objetivo - ahora) / 1000);
      pon('d', Math.floor(s / 86400)); s %= 86400;
      pon('h', Math.floor(s / 3600)); s %= 3600;
      pon('m', Math.floor(s / 60));
      pon('s', s % 60);
      setTimeout(tic, 1000 - (ahora % 1000));
    };
    tic();
  })();

  /* ---------- 5 · photocall: la foto, a oscuras con linterna ---------- */
  (() => {
    const f = document.getElementById('pc-foto')!;
    if (matchMedia('(pointer: coarse)').matches) return;
    f.addEventListener('pointermove', (e) => {
      const r = f.getBoundingClientRect();
      f.style.setProperty('--fx', `${e.clientX - r.left}px`);
      f.style.setProperty('--fy', `${e.clientY - r.top}px`);
      f.classList.add('linternita');
    });
    f.addEventListener('pointerleave', () => f.classList.remove('linternita'));
  })();

  /* ---------- sonido (solo si se activa) ---------- */
  (() => {
    const b = document.getElementById('ambiente')!;
    let amb: { encender(): Promise<void>; apagar(): void } | null = null, on = false;
    b.addEventListener('click', async () => {
      if (!amb) amb = (await import('../scripts/ambiente')).crearAmbiente();
      on = !on;
      b.setAttribute('aria-pressed', String(on));
      b.querySelector('span')!.textContent = on ? 'Sonido: sí' : 'Sonido de miedo';
      on ? amb.encender() : amb.apagar();
    });
  })();

  /* ---------- 2 · franjas ---------- */
  const franjas = [...document.querySelectorAll<HTMLElement>('.franja__track')];
  let fx = 0;
  // anchos medidos solo al cargar y al cambiar el tamaño (medir en cada fotograma provoca tirones)
  let anchos = franjas.map((t) => t.scrollWidth / 2);
  window.addEventListener('resize', () => { anchos = franjas.map((t) => t.scrollWidth / 2); });
  function pintarFranjas(dt: number) {
    fx += dt * 0.04;
    franjas.forEach((t, i) => {
      const w = anchos[i];
      const dir = Number(t.dataset.dir);
      const x = ((fx + window.scrollY * 0.35) % w + w) % w;
      t.style.transform = `translate3d(${dir < 0 ? -x : x - w}px,0,0)`;
    });
  }


  /* ---------- 4 · carta horizontal ---------- */
  const hcarta = document.querySelector<HTMLElement>('.hcarta')!;
  const track = hcarta.querySelector<HTMLElement>('.hcarta__track')!;
  const hbar = hcarta.querySelector<HTMLElement>('.hcarta__bar i')!;
  const pars = [...hcarta.querySelectorAll<HTMLElement>('[data-par]')];
  let maxTrack = track.scrollWidth - track.clientWidth;
  window.addEventListener('resize', () => { maxTrack = track.scrollWidth - track.clientWidth; });
  function pintarCarta() {
    const p = avance(hcarta);
    const max = maxTrack;
    track.style.transform = `translate3d(${-p * max}px,0,0)`;
    hbar.style.transform = `scaleX(${p})`;
    pars.forEach((el) => { el.style.translate = `0 ${(p - 0.5) * Number(el.dataset.par) * 40}px`; });
  }


  /* ---------- 7 · abierto ahora (hora de Murcia) ---------- */
  (() => {
    const el = document.getElementById('abierto')!;
    const dias = ['domingo', 'lunes', 'martes', 'miercoles', 'jueves', 'viernes', 'sabado'];
    const f = new Intl.DateTimeFormat('es-ES', { timeZone: 'Europe/Madrid', weekday: 'long', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date());
    const wd = f.find((x) => x.type === 'weekday')!.value.normalize('NFD').replace(/[̀-ͯ]/g, '');
    const mins = Number(f.find((x) => x.type === 'hour')!.value) * 60 + Number(f.find((x) => x.type === 'minute')!.value);
    const fila = document.querySelector<HTMLElement>(`[data-dia="${dias.includes(wd) ? wd : ''}"]`);
    fila?.classList.add('hoy');
    const tramos = (fila?.querySelector('dd')?.textContent ?? '').match(/\d{1,2}:\d{2}–\d{1,2}:\d{2}/g) ?? [];
    const toMin = (s: string) => { const [h, m] = s.split(':').map(Number); return h * 60 + m; };
    const abierto = tramos.some((t) => { const [a, b] = t.split('–'); return mins >= toMin(a) && mins < toMin(b); });
    const prox = tramos.map((t) => t.split('–')[0]).find((a) => toMin(a) > mins);
    el.classList.toggle('on', abierto);
    el.querySelector('span')!.textContent = abierto ? 'Abierto ahora' : prox ? `Cerrado · abrimos a las ${prox}` : 'Cerrado ahora';
  })();


  /* ---------- bucle ---------- */
  // Cada sección solo se recalcula mientras está en pantalla.
  const enPantalla = new Map<Element, boolean>();
  const vigia = new IntersectionObserver((es) => es.forEach((e) => enPantalla.set(e.target, e.isIntersecting)), { rootMargin: '200px 0px' });
  const secFranjas = document.querySelector('.franjas')!;
  [noche, secFranjas, hcarta].forEach((el) => vigia.observe(el));
  const ve = (el: Element) => enPantalla.get(el) !== false;

  let last = performance.now(), yPrev = -1;
  function tick() {
    const now = performance.now();
    const dt = Math.min(64, now - last);
    last = now;
    const y = window.scrollY, movido = y !== yPrev;
    yPrev = y;
    if (ve(secFranjas) && !reduce) pintarFranjas(dt);
    if (!movido) return;
    if (ve(noche)) pintarNoche();
    if (ve(hcarta)) pintarCarta();
  }
  (function loop() { tick(); requestAnimationFrame(loop); })();
</script>

