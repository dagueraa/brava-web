---
import Base from '../layouts/Base.astro';
import Resenas from '../components/Resenas.astro';
import Logo from '../components/Logo.astro';
import BrandIcon from '../components/BrandIcon.astro';
import Blob from '../components/Blob.astro';
import HandArrow from '../components/HandArrow.astro';
import Plato from '../components/Plato.astro';
import BotonPedido from '../components/BotonPedido.astro';
import { anadible, extraDeNota } from '../data/pedido';
import { Image } from 'astro:assets';
import { img } from '../assets/images';
import { menuFotos, type MenuFotoKey } from '../assets/menuImages';
import { categorias, type MenuItem } from '../data/menu';
import { siteConfig, waLink } from '../../site.config';

/* Todos los platos y precios salen de la carta oficial (src/data/menu.ts). */
const todos: MenuItem[] = categorias.flatMap((c) => [
  ...(c.items ?? []),
  ...(c.subsecciones?.flatMap((s) => s.items) ?? []),
  ...(c.especiales?.items ?? []),
]);
const plato = (nombre: string) => {
  const it = todos.find((i) => i.nombre === nombre);
  if (!it) throw new Error(`No está en la carta: ${nombre}`);
  return it;
};
const combos = categorias.find((c) => c.id === 'combos')!;
// cada plato con su apartado de la carta, para añadirlo al pedido con el mismo id que en /carta
const conApartado = categorias.flatMap((c) => [
  ...(c.items ?? []).map((i) => ({ i, ap: '' })),
  ...(c.subsecciones?.flatMap((s) => s.items.map((i) => ({ i, ap: s.titulo }))) ?? []),
  ...(c.especiales?.items.map((i) => ({ i, ap: c.especiales!.titulo })) ?? []),
]);
const zumo = extraDeNota(combos.nota);
const paraPedido = (it?: MenuItem) => {
  if (!it) return undefined;
  const x = conApartado.find((e) => e.i === it)!;
  return anadible(it, x.ap, combos.items!.includes(it) ? zumo : undefined);
};
// plato de la carta que corresponde a cada foto (para abrirlo de cerca con su nombre y precio)
const slug = (t: string) => t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/\s+/g, '-');
const porFoto = (k: MenuFotoKey) => todos.find((i) => i.foto === k) ?? todos.find((i) => slug(i.nombre) === k);

const panels = [
  {
    suffix: 'drinks', fondo: 'bg-brand-calm', tinta: 'text-brand-brown', kicker: 'Para beber despacio',
    fotos: ['iced-brava', 'blue-matcha', 'cafe-amarillo'] as MenuFotoKey[],
    platos: ['Iced Brava', 'Blue Matcha', 'Brava Coffee', 'Matcha Latte Pistacho', 'Pink Latte'].map(plato),
    href: '/carta#drinks',
  },
  {
    suffix: 'brunch', fondo: 'bg-brand-cream-2', tinta: 'text-brand-brown', kicker: 'Al momento',
    fotos: ['esp-salmone-brioche', 'esp-mortadella-bagel', 'focaccia-pompeyana'] as MenuFotoKey[],
    platos: ['Salmone Brioche', 'Mortadella Bagel', 'Focaccia Pompeyana', 'Brava Brioche'].map(plato),
    href: '/carta#brunch',
  },
  {
    suffix: 'treats', fondo: 'bg-brand-fresh', tinta: 'text-brand-brown', kicker: 'El capricho',
    fotos: ['brava-pop', 'esp-pistachio', 'focaccia-lotus'] as MenuFotoKey[],
    platos: ['Brava Pop', 'Pistachio Brioche', 'Focaccia Lotus', 'Nutella Brioche'].map(plato),
    href: '/carta#treats',
  },
];

const lattes = ['Caramelo Salado', 'Vainilla', 'Avellana Tostada', 'Pistacho'].map(plato);
const clasicos = ['Espresso', 'Flat White', 'Cappuccino'].map(plato);
const frase = ['café de especialidad', 'brunch', 'treats', 'para llevar', 'La Ñora'];
const iconosFranja = ['croissant', 'cafe', 'cookie', 'smoothie', 'muffin'] as const;
const objetivo = siteConfig.bravaPass.objetivo;
---
<Base title="Inicio" path="">
  <!-- ═════════ 1 · LA TAZA 3D (scroll coreografiado) ═════════ -->
  <section id="epica" class="epica relative bg-brand-brown text-brand-cream" aria-label="Brava coffee and brunch">
    <div class="epica__stage">
      <div class="epica__stripes" aria-hidden="true"></div>
      <div class="epica__word" aria-hidden="true"><Logo class="text-brand-cream" /></div>
      <canvas id="taza3d" class="epica__canvas" aria-hidden="true"></canvas>
      <div class="epica__fallback" aria-hidden="true">
        <Image src={img.hero} alt="" widths={[480, 800]} sizes="(max-width: 768px) 80vw, 420px" loading="eager" class="h-full w-full rounded-[2.5rem] object-cover" />
      </div>

      <!-- Paso 0 -->
      <div class="epica__step epica__step--intro" data-from="0" data-to="0.16">
        <p class="epica__kicker">Café de especialidad · Brunch · {siteConfig.ciudad}, {siteConfig.provincia}</p>
        <h1 class="epica__h1">Café de especialidad y brunch, <span class="font-hand text-brand-fresh">hecho con calma.</span></h1>
        <div class="epica__ctas">
          <a href="/carta" class="btn-e btn-e--fresh">Ver la carta</a>
          <a href="/brava-pass" class="btn-e btn-e--ghost">Brava Pass</a>
        </div>
      </div>
      <!-- Paso 1 -->
      <div class="epica__step epica__step--left" data-from="0.2" data-to="0.42">
        <p class="font-hand text-3xl text-brand-fresh sm:text-4xl">el primero de la mañana</p>
        <h2 class="epica__h2">Donde el café sabe a café.</h2>
        <p class="epica__p">Y el pan a pan, y las cosas se hacen con intención.</p>
        <ul class="epica__chips">
          {clasicos.map((c) => <li><span>{c.nombre}</span><b>{c.precio} €</b></li>)}
        </ul>
      </div>
      <!-- Paso 2 (vista cenital del latte art) -->
      <div class="epica__step epica__step--bottom" data-from="0.46" data-to="0.64">
        <p class="font-hand text-3xl text-brand-fresh sm:text-4xl">latte macchiato especiales</p>
        <h2 class="epica__h2">Ponle tu sabor.</h2>
        <ul class="epica__chips justify-center">
          {lattes.map((c) => <li><span>{c.nombre}</span><b>{c.precio} €</b></li>)}
        </ul>
      </div>
      <!-- Paso 3 -->
      <div class="epica__step epica__step--left" data-from="0.7" data-to="1.01">
        <Logo suffix="combos" class="text-4xl text-brand-cream sm:text-5xl" />
        <h2 class="epica__h2 mt-4">Empieza bien el día.</h2>
        <p class="epica__p">{combos.items![0].nombre}: {combos.items![0].desc!.toLowerCase()}, <b class="text-brand-fresh">{combos.items![0].precio} €</b>.</p>
        <div class="epica__ctas !justify-start">
          <a href="/carta" class="btn-e btn-e--fresh">Ver la carta</a>
          <a href="/to-go" class="btn-e btn-e--ghost">Pedir para llevar</a>
        </div>
      </div>

      <div class="epica__hint" aria-hidden="true"><span>desliza</span><i></i></div>
      <div class="epica__bar" aria-hidden="true"><i></i></div>
    </div>
  </section>

  <!-- ═════════ 2 · FRANJAS CRUZADAS ═════════ -->
  <section class="franjas" aria-label="Café de especialidad, brunch, treats y para llevar en La Ñora">
    <div class="franja franja--fresh"><div class="franja__track" data-dir="-1">
      {Array.from({ length: 2 }).map(() => (
        <div class="franja__group" aria-hidden="true">
          {Array.from({ length: 3 }).flatMap(() => frase).map((f, i) => (
            <><span>{f}</span><BrandIcon name={iconosFranja[i % iconosFranja.length]} class="h-9 w-9 shrink-0 sm:h-11 sm:w-11" /></>
          ))}
        </div>
      ))}
    </div></div>
    <div class="franja franja--calm"><div class="franja__track" data-dir="1">
      {Array.from({ length: 2 }).map(() => (
        <div class="franja__group" aria-hidden="true">
          {Array.from({ length: 3 }).flatMap(() => ['hello brava!', 'coffee and brunch', 'por venir, te damos']).map((f) => (
            <><span class="font-hand !font-semibold normal-case !tracking-normal">{f}</span><span class="opacity-60">✦</span></>
          ))}
        </div>
      ))}
    </div></div>
  </section>

  <!-- ═════════ 3 · COMBOS (tarjetas que se apilan) ═════════ -->
  <section class="mx-auto w-full max-w-6xl px-5 pb-10 pt-6 sm:px-6">
    <div class="mb-10 flex flex-col items-center text-center">
      <p class="font-hand text-3xl text-brand-calm-ink">nuestros favoritos</p>
      <Logo as="h2" suffix="combos" class="mt-1 text-5xl text-brand-brown sm:text-6xl" />
    </div>
    <div class="stack">
      {combos.items!.map((c, i) => (
        <article class={`stack__card ${['bg-brand-cream-2', 'bg-brand-calm', 'bg-brand-fresh'][i]}`} style={`--i:${i}`}>
          <div class="stack__fotos">
            <Blob class="inset-0 h-full w-full scale-110 text-brand-cream/70" variant={((i % 3) + 1) as 1 | 2 | 3} />
            <Plato foto={c.cafe as MenuFotoKey} alt="Café de especialidad de Brava" nombre={c.nombre} precio={c.precio} desc={c.desc} a={paraPedido(c)} widths={[260, 420, 560]} sizes="(max-width: 768px) 46vw, 300px" class="stack__cafe" />
            <Plato foto={c.foto as MenuFotoKey} alt={c.nombre} nombre={c.nombre} precio={c.precio} desc={c.desc} a={paraPedido(c)} widths={[280, 460, 620]} sizes="(max-width: 768px) 50vw, 320px" class="stack__comida" />
            <HandArrow class="absolute -right-2 bottom-6 hidden w-24 text-brand-brown md:block" />
          </div>
          <div class="stack__txt">
            <p class="stack__n">0{i + 1}</p>
            <h3 class="stack__nombre">{c.nombre}</h3>
            <p class="stack__desc">{c.desc}</p>
            <p class="stack__precio">{c.precio}<span>€</span></p>
            <BotonPedido a={paraPedido(c)!} texto="Añadir al pedido" class="mt-6" />
          </div>
        </article>
      ))}
    </div>
    {combos.nota && <p class="mt-8 text-center text-sm font-semibold text-brand-brown-80">{combos.nota}</p>}
  </section>

  <!-- ═════════ 4 · LA CARTA EN HORIZONTAL ═════════ -->
  <section class="hcarta" aria-label="La carta de Brava">
    <div class="hcarta__stage">
      <div class="hcarta__head">
        <p class="font-hand text-3xl text-brand-calm-ink">la carta, de un vistazo</p>
        <h2 class="text-3xl font-bold text-brand-brown sm:text-5xl">Todo lo que te espera.</h2>
      </div>
      <div class="hcarta__track">
        {panels.map((p, i) => (
          <article class={`hpanel ${p.fondo} ${p.tinta}`}>
            <div class="hpanel__fotos">
              {p.fotos.map((f, k) => (
                <div class={`hpanel__foto hpanel__foto--${k}`} data-par={(k + 1) * (i % 2 ? -1 : 1)}>
                  <Plato foto={f} alt={porFoto(f)?.nombre ?? 'Café de especialidad'} nombre={porFoto(f)?.nombre} precio={porFoto(f)?.precio} desc={porFoto(f)?.desc} a={paraPedido(porFoto(f))} widths={[240, 400, 560]} sizes="(max-width: 768px) 38vw, 300px" />
                </div>
              ))}
            </div>
            <div class="hpanel__txt">
              <p class="font-hand text-2xl opacity-80 sm:text-3xl">{p.kicker}</p>
              <Logo as="h3" suffix={p.suffix} class="text-4xl sm:text-5xl" />
              <ul class="hpanel__lista">
                {p.platos.map((pl) => (
                  <li><span><b>{pl.nombre}</b>{pl.desc && <small>{pl.desc}</small>}</span><em>{pl.precio} €</em><BotonPedido a={paraPedido(pl)!} class="hpanel__mas" /></li>
                ))}
              </ul>
              <a href={p.href} class="btn-e btn-e--brown mt-5">Ver {p.suffix}</a>
            </div>
          </article>
        ))}
        <article class="hpanel hpanel--fin bg-brand-brown text-brand-cream">
          <BrandIcon name="bolsa" class="h-24 w-24 text-brand-fresh" />
          <Logo as="h3" suffix="to go" class="mt-5 text-4xl text-brand-cream sm:text-5xl" />
          <p class="mt-3 max-w-xs text-brand-cream/80">Pídelo por WhatsApp y pásate a recogerlo en {siteConfig.toGo.tiempoPreparacionMin} minutos.</p>
          <div class="mt-6 flex flex-wrap justify-center gap-3">
            <a href="/carta" class="btn-e btn-e--fresh">Carta completa</a>
            <a href="/to-go" class="btn-e btn-e--ghost">Para llevar</a>
          </div>
        </article>
      </div>
      <div class="hcarta__bar" aria-hidden="true"><i></i></div>
    </div>
  </section>

  <!-- ═════════ 5 · BRAVA PASS v2 ═════════ -->
  <section class="pass relative bg-brand-brown text-brand-cream" aria-label="Brava Pass">
    <div class="pass__stage">
      <div class="pass__rejilla mx-auto grid w-full max-w-6xl items-center gap-10 px-5 sm:px-6 md:grid-cols-[1.1fr_1fr]">
        <div class="pass__txt">
          <p class="font-hand text-3xl text-brand-fresh sm:text-4xl">por venir, te damos</p>
          <Logo as="h2" suffix="pass" class="mt-1 text-5xl text-brand-cream sm:text-6xl" />
          <p class="pass__desc mt-4 max-w-md text-lg leading-relaxed text-brand-cream/80">Tu tarjeta de cafés, en el móvil y sin cartón. Pagas, escaneas el QR de la barra y el sello se pone solo.</p>
          <ol class="pass__pasos">
            <li data-at="0.05"><b>1</b><span><strong>Hazte el pass en 20 segundos.</strong> Solo tu nombre. Sin apps ni contraseñas.</span></li>
            <li data-at="0.3"><b>2</b><span><strong>Pide y escanea.</strong> En la barra te enseñan un QR; lo apuntas con la cámara y tu café queda sellado.</span></li>
            <li data-at="0.6"><b>3</b><span><strong>Al {objetivo}º, invita Brava.</strong> El café gratis aparece en tu pass y lo canjeas cuando quieras.</span></li>
            <li data-at="0.85"><b><BrandIcon name="muffin" class="h-5 w-5" /></b><span><strong>Y en tu cumpleaños,</strong> el brunch corre de nuestra cuenta.</span></li>
          </ol>
          <a href="/brava-pass" class="pass__cta btn-e btn-e--fresh mt-8">Consigue tu Brava Pass</a>
        </div>
        <div class="pass__phone" aria-hidden="true">
          <div class="phone">
            <div class="phone__notch"></div>
            <div class="phone__screen">
              <div class="flex items-center justify-between">
                <Logo suffix="pass" class="text-2xl text-brand-brown" />
                <span class="rounded-full bg-brand-brown px-2.5 py-1 text-[10px] font-bold tracking-wider text-brand-cream">K7Q4MZ</span>
              </div>
              <p class="mt-4 text-sm text-brand-brown-80">Hola, <b class="text-brand-brown">Lucía</b></p>
              <p class="pass__cuenta"><span id="pass-n">0</span><small>/ {objetivo} cafés</small></p>
              <div class="pass__sellos">
                {Array.from({ length: objetivo }).map((_, i) => (
                  <span class="sello" style={`--d:${i}`}><BrandIcon name="taza" class="h-6 w-6" /></span>
                ))}
              </div>
              <div class="pass__premio"><BrandIcon name="cafe" class="h-7 w-7" /><span><b>¡Café gratis!</b><small>Enséñalo en barra</small></span></div>
              <div class="pass__qr">
                <svg viewBox="0 0 29 29" class="h-full w-full" shape-rendering="crispEdges"><path id="qr-demo" fill="currentColor" d="" /></svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═════════ 6 · EL ALMA ═════════ -->
  <section class="mx-auto grid w-full max-w-6xl items-center gap-10 px-5 py-24 sm:px-6 md:grid-cols-2">
    <div class="alma__foto relative">
      <Blob class="-inset-6 -z-10 h-[115%] w-[115%] text-brand-fresh/60" variant={2} />
      <Image src={img.founderSpace} alt="La dueña de Brava junto al rótulo de musgo brava coffee and brunch" widths={[360, 560, 760]} sizes="(max-width: 768px) 90vw, 520px" class="aspect-[4/5] w-full rounded-[2.5rem] object-cover shadow-2xl" loading="lazy" data-par="1" />
    </div>
    <div>
      <p class="font-hand text-3xl text-brand-calm-ink">{siteConfig.historia.titulo}</p>
      <h2 class="mt-2 text-4xl font-bold leading-[1.02] text-brand-brown sm:text-6xl">No es solo un café.</h2>
      <p class="mt-5 text-xl leading-relaxed text-brand-brown-80">{siteConfig.historia.frase.replace('No es solo un café. ', '')} Un lugar pequeño, pero con alma, creado para disfrutar, desconectar y sentirse como en casa.</p>
      <a href="/historia" class="btn-e btn-e--brown mt-8">Conoce nuestra historia</a>
    </div>
  </section>

  <Resenas />

  <!-- ═════════ 7 · VEN A VERNOS ═════════ -->
  <section class="mx-auto w-full max-w-6xl px-5 pb-20 sm:px-6">
    <div class="visita">
      <Image src={img.entrada} alt="Entrada de Brava: rótulo brava sobre la pared vegetal" widths={[480, 800, 1100]} sizes="(max-width: 768px) 100vw, 560px" class="visita__foto" loading="lazy" />
      <div class="visita__txt">
        <p id="abierto" class="visita__estado"><i></i><span>Horario</span></p>
        <h2 class="mt-4 text-4xl font-bold text-brand-cream sm:text-5xl">Te esperamos en La Ñora.</h2>
        <p class="mt-3 text-lg text-brand-cream/80">{siteConfig.direccion}</p>
        <dl class="visita__horario">
          {Object.entries(siteConfig.horario).map(([d, h]) => (
            <div data-dia={d}><dt>{d === 'miercoles' ? 'miércoles' : d === 'sabado' ? 'sábado' : d}</dt><dd>{h}</dd></div>
          ))}
        </dl>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={siteConfig.mapsUrl} target="_blank" rel="noopener noreferrer" class="btn-e btn-e--fresh">Cómo llegar</a>
          <a href={waLink('¡Hola Brava!')} target="_blank" rel="noopener noreferrer" class="btn-e btn-e--ghost">WhatsApp</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import qrcode from 'qrcode-generator';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  /* Avance (0–1) de una sección alta mientras su escenario está fijo en pantalla.
     Se mide con el escenario real (alto y margen superior del sticky), no con la ventana,
     y la animación acaba al 88 %: el último estado se queda quieto antes de soltarse. */
  const FIN = 0.88;
  const escenarios = new Map<HTMLElement, HTMLElement | null>();
  const avance = (el: HTMLElement) => {
    if (!escenarios.has(el)) escenarios.set(el, el.querySelector<HTMLElement>(':scope > [class$="__stage"]'));
    const st = escenarios.get(el);
    const fijo = st && getComputedStyle(st).position === 'sticky';
    const arriba = fijo ? parseFloat(getComputedStyle(st!).top) || 0 : 0;
    const recorrido = el.offsetHeight - (fijo ? st!.offsetHeight : window.innerHeight);
    const r = el.getBoundingClientRect();
    return recorrido > 0 ? clamp((arriba - r.top) / recorrido / FIN) : 0;
  };

  /* ---------- 1 · taza 3D ---------- */
  const epica = document.getElementById('epica')!;
  const canvas = document.getElementById('taza3d') as HTMLCanvasElement;
  const steps = [...epica.querySelectorAll<HTMLElement>('.epica__step')];
  const bar = epica.querySelector<HTMLElement>('.epica__bar i')!;
  const word = epica.querySelector<HTMLElement>('.epica__word')!;
  let taza: { setProgress(p: number): void; setTilt(x: number, y: number): void } | null = null;

  const webgl = (() => { try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; } })();
  if (webgl && !reduce) {
    // Se carga después de pintar el texto, para que la portada salga al instante.
    const arrancar = () => import('../scripts/taza3d').then(({ crearTaza }) =>
      crearTaza(canvas, { onReady: () => epica.classList.add('is-3d') }).then((t) => { taza = t; pintarEpica(); }),
    ).catch(() => epica.classList.add('no-3d'));
    'requestIdleCallback' in window ? requestIdleCallback(arrancar, { timeout: 900 }) : setTimeout(arrancar, 300);
    // En móvil, el giroscopio también inclina la escena.
    window.addEventListener('deviceorientation', (e) => {
      if (e.gamma == null || e.beta == null) return;
      taza?.setTilt(clamp((e.gamma + 30) / 60) * 2 - 1, clamp((e.beta - 20) / 60) * 2 - 1);
    }, { passive: true });
  } else {
    epica.classList.add('no-3d');
  }

  function pintarEpica() {
    const p = avance(epica);
    taza?.setProgress(p);
    bar.style.transform = `scaleX(${p})`;
    word.style.transform = `translate(-50%, -50%) scale(${1 + p * 0.5})`;
    word.style.opacity = String(0.06 * (1 - clamp((p - 0.25) / 0.2)) + 0.025);
    epica.classList.toggle('is-moving', p > 0.02);
    steps.forEach((s) => {
      const a = parseFloat(s.dataset.from!), b = parseFloat(s.dataset.to!);
      const fin = b > 1 ? 1 : clamp((b - p) / 0.04);
      const k = Math.min(a === 0 ? 1 : clamp((p - a) / 0.04), fin);
      s.style.opacity = String(k);
      s.style.transform = `translateY(${(1 - k) * 24}px)`;
      s.style.visibility = k < 0.01 ? 'hidden' : 'visible';
    });
  }

  /* ---------- 2 · franjas ---------- */
  const franjas = [...document.querySelectorAll<HTMLElement>('.franja__track')];
  let fx = 0;
  // anchos medidos solo al cargar y al cambiar el tamaño (medir en cada fotograma provoca tirones)
  let anchos = franjas.map((t) => t.scrollWidth / 2);
  window.addEventListener('resize', () => { anchos = franjas.map((t) => t.scrollWidth / 2); });
  function pintarFranjas(dt: number) {
    fx += dt * 0.04;
    franjas.forEach((t, i) => {
      const w = anchos[i];
      const dir = Number(t.dataset.dir);
      const x = ((fx + window.scrollY * 0.35) % w + w) % w;
      t.style.transform = `translate3d(${dir < 0 ? -x : x - w}px,0,0)`;
    });
  }

  /* ---------- 4 · carta horizontal ---------- */
  const hcarta = document.querySelector<HTMLElement>('.hcarta')!;
  const track = hcarta.querySelector<HTMLElement>('.hcarta__track')!;
  const hbar = hcarta.querySelector<HTMLElement>('.hcarta__bar i')!;
  const pars = [...hcarta.querySelectorAll<HTMLElement>('[data-par]')];
  let maxTrack = track.scrollWidth - track.clientWidth;
  window.addEventListener('resize', () => { maxTrack = track.scrollWidth - track.clientWidth; });
  function pintarCarta() {
    const p = avance(hcarta);
    const max = maxTrack;
    track.style.transform = `translate3d(${-p * max}px,0,0)`;
    hbar.style.transform = `scaleX(${p})`;
    pars.forEach((el) => { el.style.translate = `0 ${(p - 0.5) * Number(el.dataset.par) * 40}px`; });
  }

  /* ---------- 5 · pass: los sellos se llenan con el scroll ---------- */
  const pass = document.querySelector<HTMLElement>('.pass')!;
  const sellos = [...pass.querySelectorAll<HTMLElement>('.sello')];
  const pasos = [...pass.querySelectorAll<HTMLElement>('.pass__pasos li')];
  const passN = document.getElementById('pass-n')!;
  const total = sellos.length;
  function pintarPass() {
    const p = avance(pass);
    const n = Math.min(total, Math.floor(clamp((p - 0.1) / 0.65) * (total + 0.999)));
    sellos.forEach((s, i) => s.classList.toggle('on', i < n));
    passN.textContent = String(n);
    pass.classList.toggle('premio', n >= total);
    pasos.forEach((li) => li.classList.toggle('on', p >= parseFloat(li.dataset.at!)));
    const ult = pasos.filter((li) => li.classList.contains('on')).pop() ?? pasos[0];
    pasos.forEach((li) => li.classList.toggle('actual', li === ult));
  }
  // QR de muestra (el de verdad lo genera el pass de cada cliente)
  const qr = qrcode(3, 'M');
  qr.addData('BRAVA:K7Q4MZ');
  qr.make();
  const nq = qr.getModuleCount();
  let d = '';
  for (let r = 0; r < nq; r++) for (let c = 0; c < nq; c++) if (qr.isDark(r, c)) d += `M${c} ${r}h1v1h-1z`;
  const qrPath = document.getElementById('qr-demo')!;
  qrPath.setAttribute('d', d);
  qrPath.parentElement!.setAttribute('viewBox', `-1 -1 ${nq + 2} ${nq + 2}`);

  /* ---------- parallax suave ---------- */
  const alma = document.querySelector<HTMLElement>('.alma__foto img');
  function pintarAlma() {
    if (!alma) return;
    const r = alma.getBoundingClientRect();
    const k = (r.top + r.height / 2 - window.innerHeight / 2) / window.innerHeight;
    alma.style.transform = `translateY(${k * -40}px) rotate(${k * -3}deg)`;
  }

  /* ---------- 7 · abierto ahora (hora de Murcia) ---------- */
  (() => {
    const el = document.getElementById('abierto')!;
    const dias = ['domingo', 'lunes', 'martes', 'miercoles', 'jueves', 'viernes', 'sabado'];
    const f = new Intl.DateTimeFormat('es-ES', { timeZone: 'Europe/Madrid', weekday: 'long', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date());
    const wd = f.find((x) => x.type === 'weekday')!.value.normalize('NFD').replace(/[̀-ͯ]/g, '');
    const mins = Number(f.find((x) => x.type === 'hour')!.value) * 60 + Number(f.find((x) => x.type === 'minute')!.value);
    const fila = document.querySelector<HTMLElement>(`[data-dia="${dias.includes(wd) ? wd : ''}"]`);
    fila?.classList.add('hoy');
    const tramos = (fila?.querySelector('dd')?.textContent ?? '').match(/\d{1,2}:\d{2}–\d{1,2}:\d{2}/g) ?? [];
    const toMin = (s: string) => { const [h, m] = s.split(':').map(Number); return h * 60 + m; };
    const abierto = tramos.some((t) => { const [a, b] = t.split('–'); return mins >= toMin(a) && mins < toMin(b); });
    const prox = tramos.map((t) => t.split('–')[0]).find((a) => toMin(a) > mins);
    el.classList.toggle('on', abierto);
    el.querySelector('span')!.textContent = abierto ? 'Abierto ahora' : prox ? `Cerrado · abrimos a las ${prox}` : 'Cerrado ahora';
  })();

  /* ---------- bucle ---------- */
  // Cada sección solo se recalcula mientras está en pantalla.
  const enPantalla = new Map<Element, boolean>();
  const vigia = new IntersectionObserver((es) => es.forEach((e) => enPantalla.set(e.target, e.isIntersecting)), { rootMargin: '200px 0px' });
  const secFranjas = document.querySelector('.franjas')!;
  const secAlma = document.querySelector('.alma__foto')!;
  [epica, secFranjas, hcarta, pass, secAlma].forEach((el) => vigia.observe(el));
  const ve = (el: Element) => enPantalla.get(el) !== false;

  let last = performance.now(), yPrev = -1;
  function tick() {
    const now = performance.now();
    const dt = Math.min(64, now - last);
    last = now;
    const y = window.scrollY, movido = y !== yPrev;
    yPrev = y;
    if (ve(secFranjas) && !reduce) pintarFranjas(dt); // la franja se mueve sola
    if (!movido) return; // el resto solo depende del scroll
    if (ve(epica)) pintarEpica();
    if (ve(hcarta)) pintarCarta();
    if (ve(pass)) pintarPass();
    if (ve(secAlma) && !reduce) pintarAlma();
  }
  (function loop() { tick(); requestAnimationFrame(loop); })();
</script>

