---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Blob from '../components/Blob.astro';
import Logo from '../components/Logo.astro';
import BravaPass from '../components/BravaPass.astro';
import { siteConfig } from '../../site.config';

const privilegios = siteConfig.bravaPass.privilegios;
---
<Base
  title="Brava Pass"
  description="Brava Pass: tu tarjeta de fidelidad digital. 10 cafés = 1 gratis, brunch en tu cumpleaños y acceso anticipado. Sin apps, sin complicaciones."
  path="/brava-pass"
>
  <!-- Apertura -->
  <Section width="wide" class="relative overflow-hidden pt-14 pb-6 text-center">
    <Blob class="-top-16 left-1/2 h-64 w-64 -translate-x-1/2 text-brand-fresh/30" variant={2} />
    <Logo class="relative text-2xl text-brand-brown-60" />
    <h1 class="relative mt-1 text-5xl font-bold text-brand-brown sm:text-6xl">
      Brava <span class="font-hand text-brand-calm-ink">Pass</span>
    </h1>
    <p class="relative mx-auto mt-5 max-w-xl text-lg leading-relaxed text-brand-brown-80">
      Por venir, te damos. Sin apps complicadas: una tarjeta, tu nombre y muchos cafés gratis por delante.
    </p>
  </Section>

  <!-- Privilegios -->
  <Section width="wide" class="py-8">
    <div class="grid gap-5 sm:grid-cols-3">
      {privilegios.map((p) => (
        <div class="flex flex-col items-center rounded-3xl border rule-soft bg-brand-cream-2/40 p-7 text-center">
          <div class="grid h-16 w-16 place-items-center rounded-full bg-brand-brown text-brand-cream">
            {p.icono === '10' && <span class="text-2xl font-extrabold">10</span>}
            {p.icono === 'cake' && (
              <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v3M9 6.5 12 4l3 2.5M4 21v-7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v7M4 21h16M3 14c1.5 1.2 3 1.2 4.5 0S10.5 12.8 12 14s3 1.2 4.5 0S19.5 12.8 21 14"/></svg>
            )}
            {p.icono === 'star' && (
              <svg class="h-8 w-8" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 17.27 5.18 3.13-1.37-5.9 4.55-3.94-5.99-.51L12 4.5 9.63 10.05l-5.99.51 4.55 3.94-1.37 5.9z"/></svg>
            )}
          </div>
          <h2 class="mt-4 text-lg font-bold text-brand-brown">{p.titulo}</h2>
          <p class="mt-1 text-sm leading-relaxed text-brand-brown-80">{p.desc}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- La tarjeta interactiva -->
  <Section width="default" class="py-10">
    <BravaPass />
  </Section>

  <!-- Cómo funciona -->
  <Section width="narrow" class="pb-16">
    <div class="rounded-3xl bg-brand-cream-2/50 p-7">
      <h2 class="text-lg font-bold text-brand-brown">¿Cómo funciona?</h2>
      <ol class="mt-3 space-y-2 text-sm leading-relaxed text-brand-brown-80">
        <li><span class="font-semibold text-brand-brown">1.</span> Déjanos una reseña y activa tu pass con tu nombre.</li>
        <li><span class="font-semibold text-brand-brown">2.</span> Cada vez que pidas un café, el personal te suma un sello.</li>
        <li><span class="font-semibold text-brand-brown">3.</span> Al llegar a {siteConfig.bravaPass.objetivo}, el siguiente café es <span class="font-semibold text-brand-brown">gratis</span>. Lo canjeas y la tarjeta vuelve a empezar.</li>
        <li><span class="font-semibold text-brand-brown">4.</span> ¿Es tu cumpleaños? Enséñanos tu pass y el brunch corre de nuestra cuenta.</li>
      </ol>
      <p class="mt-4 text-xs text-brand-brown-60">
        Tu Brava Pass se guarda en este dispositivo, sin instalar nada ni dar tu correo. Si cambias de móvil, vuelve a activarlo.
      </p>
    </div>
  </Section>
</Base>
