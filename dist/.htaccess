# hellobrava.es · Hostinger
ErrorDocument 404 /404.html
RewriteEngine On
# Siempre con https y sin www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://hellobrava.es%{REQUEST_URI} [L,R=301]
# Nadie puede descargar bases de datos ni archivos ocultos (salvo este)
<FilesMatch "\.(sqlite|sqlite3|db)$">
  Require all denied
</FilesMatch>
# Caché larga para los archivos con huella (_astro)
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|avif|png|jpg|woff2|glb)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
