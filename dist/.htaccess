# hellobrava.es · Hostinger
ErrorDocument 404 /404.html
RewriteEngine On
# Siempre con https y sin www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://hellobrava.es%{REQUEST_URI} [L,R=301]
# Nadie puede descargar bases de datos ni archivos ocultos (salvo este)
<FilesMatch "\.(sqlite|sqlite3|db)$">
  Require all denied
</FilesMatch>
# Caché: js, css y fuentes llevan huella → un año; fotos y 3D un mes comprobando cambios (una foto que cambia, con otro nombre); páginas siempre frescas
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|avif|png|jpg|svg|glb)$">
    Header set Cache-Control "public, max-age=2592000, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # HTTPS siempre · solo dagueraa.com puede meter esta web dentro de otra (la enseña en vivo en Tripulación; por eso no hay X-Frame-Options) · la cámara solo para escanear el QR del Brava Pass
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "frame-ancestors 'self' https://dagueraa.com; upgrade-insecure-requests"
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>
